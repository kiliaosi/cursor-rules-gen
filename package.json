{
  "name": "cursor-rules-gen",
  "displayName": "Cursor Rules Gen",
  "version": "0.1.0",
  "description": "Auto-generate .cursor/rules/ from your project's tech stack",
  "keywords": [
    "cursor",
    "cursor-rules",
    "ai",
    "codegen",
    "developer-tools",
    "dx"
  ],
  "author": "kiliaosi",
  "publisher": "kiliaosi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiliaosi/cursor-rules-gen.git"
  },
  "bin": {
    "cursor-rules-gen": "./dist/cli.mjs"
  },
  "main": "./dist/extension.cjs",
  "type": "module",
  "engines": {
    "node": ">=18",
    "vscode": "^1.90.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cursorRulesGen.generate",
        "title": "Cursor Rules: Generate"
      },
      {
        "command": "cursorRulesGen.preview",
        "title": "Cursor Rules: Preview (no write)"
      },
      {
        "command": "cursorRulesGen.selectModel",
        "title": "Cursor Rules: Select Model"
      }
    ],
    "configuration": {
      "title": "Cursor Rules Gen",
      "properties": {
        "cursorRulesGen.promptOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "Offer to generate rules when opening a project without .cursor/rules."
        },
        "cursorRulesGen.model": {
          "type": "string",
          "default": "auto",
          "description": "Cursor model used for rule generation via cursor-agent. Use 'auto' or run the 'Cursor Rules: Select Model' command to pick from available models."
        }
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.7",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.1",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.8"
  }
}
